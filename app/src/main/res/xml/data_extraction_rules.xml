<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Backs up settings (files/datastore) and the database; skips caches and exports. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="thumbnails/" />
        <exclude domain="file" path="exports/" />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
