<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base window theme; all UI colors come from Compose (ui/theme). -->
    <style name="Theme.PdfViewer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.PdfViewer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/window_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PdfViewer</item>
    </style>
</resources>
