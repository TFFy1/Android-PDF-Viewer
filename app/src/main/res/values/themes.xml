<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Window-level theme only; every UI color comes from Compose (ui/theme). The base style is
      overridden in values-night so the window background matches the Compose theme on launch.
    -->
    <style name="Base.Theme.PdfViewer" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="android:colorAccent">@color/ic_launcher_background</item>
    </style>

    <style name="Theme.PdfViewer" parent="Base.Theme.PdfViewer" />

    <!-- Launch theme (referenced by the manifest); core-splashscreen swaps to Theme.PdfViewer. -->
    <style name="Theme.PdfViewer.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PdfViewer</item>
    </style>
</resources>
